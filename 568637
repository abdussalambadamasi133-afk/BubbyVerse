/* GENERAL STYLING */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: #10091C;
    color: #FFFFFF;
    line-height: 1.6;
}


/* HEADER */

header {
    background-color: #1C1030;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

header h1 {
    color: #BD83FF;
    font-size: 28px;
}

nav a {
    color: #FFFFFF;
    text-decoration: none;
    margin: 10px;
    font-size: 15px;
}

nav a:hover {
    color: #BD83FF;
}


/* HOME SECTION */

#home {
    text-align: center;
    padding: 110px 20px;
    background: linear-gradient(135deg, #24103E, #10091C);
}

#home h2 {
    color: #D0A5FF;
    font-size: 45px;
    margin-bottom: 15px;
}

#home p {
    color: #DDDDDD;
    font-size: 18px;
    margin-bottom: 25px;
}

#home a {
    display: inline-block;
    background-color: #873EE8;
    color: #FFFFFF;
    padding: 12px 28px;
    text-decoration: none;
    border-radius: 25px;
}

#home a:hover {
    background-color: #BD83FF;
}


/* GENERAL SECTIONS */

section {
    padding: 65px 10%;
    text-align: center;
}

section h2 {
    color: #BD83FF;
    font-size: 30px;
    margin-bottom: 20px;
}

section p {
    color: #DDDDDD;
    max-width: 750px;
    margin: auto;
}


/* SERVICES SECTION */

#services div {
    display: inline-block;
    background-color: #241637;
    padding: 30px;
    width: 250px;
    margin: 15px;
    border: 1px solid #59358A;
    border-radius: 12px;
    vertical-align: top;
}

#services h3 {
    color: #C99AFF;
    margin-bottom: 12px;
}


/* PROJECTS SECTION */

#projects {
    background-color: #1C1030;
}


/* CONTACT SECTION */

#contact {
    background-color: #10091C;
}

#contact form {
    max-width: 500px;
    margin: 30px auto 0;
}

#contact input,
#contact textarea {
    width: 100%;
    padding: 15px;
    margin-bottom: 15px;
    background-color: #241637;
    color: #FFFFFF;
    border: 1px solid #873EE8;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
}

#contact input::placeholder,
#contact textarea::placeholder {
    color: #C99AFF;
}

#contact input:focus,
#contact textarea:focus {
    border: 2px solid #BD83FF;
}

#contact button {
    background-color: #873EE8;
    color: #FFFFFF;
    padding: 12px 28px;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    font-size: 16px;
}

#contact button:hover {
    background-color: #BD83FF;
}


/* FOOTER */

footer {
    background-color: #0A0612;
    padding: 25px;
    text-align: center;
    color: #BD83FF;
}


/* MOBILE RESPONSIVENESS */

@media (max-width: 600px) {

    header {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }

    #home h2 {
        font-size: 32px;
    }

    #services div {
        width: 100%;
        margin: 10px 0;
    }

}
/* SMOOTH ANIMATIONS */

/* HEADER */
header {
    animation: slideDown 1s ease;
}

/* HOME SECTION */
#home h2 {
    animation: fadeIn 1.5s ease;
}

#home p {
    animation: fadeIn 2s ease;
}

#home a {
    transition: 0.4s;
}

#home a:hover {
    transform: scale(1.08);
}

/* NAVIGATION */
nav a {
    transition: 0.3s ease;
}

nav a:hover {
    letter-spacing: 1px;
}

/* SERVICE CARDS */
#services div {
    transition: 0.4s ease;
}

#services div:hover {
    transform: translateY(-10px);
    box-shadow: 0 8px 20px rgba(135, 62, 232, 0.3);
    border-color: #BD83FF;
}

/* BUTTON ANIMATION */
button {
    transition: 0.4s ease;
}

button:hover {
    transform: scale(1.05);
}

/* ANIMATION EFFECTS */

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}
/* BUBBYVERSE LOGO */

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-icon {
    width: 45px;
    height: 45px;
    background: linear-gradient(135deg, #873EE8, #BD83FF);
    color: #FFFFFF;
    font-size: 28px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    box-shadow: 0 0 15px rgba(135, 62, 232, 0.5);
}

.logo h1 {
    color: #BD83FF;
    font-size: 28px;
    letter-spacing: 1px;
}
/* PROJECT CARDS */

.project-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 35px;
}

.project-card {
    background-color: #241637;
    border: 1px solid #59358A;
    border-radius: 15px;
    padding: 30px 20px;
    width: 280px;
    transition: 0.4s ease;
}

.project-card h3 {
    color: #C99AFF;
    margin-bottom: 15px;
    font-size: 20px;
}

.project-card p {
    color: #DDDDDD;
    font-size: 15px;
}

.project-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 8px 20px rgba(135, 62, 232, 0.3);
    border-color: #BD83FF;
}
/* CLASSY OUR STORY SECTION */

#story {
    background: linear-gradient(135deg, #160C25, #241637);
    padding: 90px 10%;
}

.story-label {
    display: inline-block;
    color: #BD83FF;
    font-size: 13px;
    letter-spacing: 4px;
    font-weight: bold;
    margin-bottom: 15px;
}

#story h2 {
    color: #FFFFFF;
    font-size: 38px;
    margin-bottom: 25px;
    letter-spacing: 1px;
}

#story p {
    color: #D6C9E5;
    font-size: 17px;
    line-height: 2;
    max-width: 750px;
}

#story h3 {
    color: #BD83FF;
    font-size: 22px;
    margin-top: 30px;
    letter-spacing: 2px;
}
/* PREMIUM HOMEPAGE DESIGN */

#home {
    background:
        radial-gradient(circle at top right, #3B1763, transparent 45%),
        linear-gradient(135deg, #24103E, #10091C);
    padding: 130px 20px;
}

.hero-label {
    display: inline-block;
    color: #BD83FF;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 4px;
    margin-bottom: 25px;
}

#home h2 {
    color: #FFFFFF;
    font-size: 48px;
    line-height: 1.3;
    margin-bottom: 25px;
}

#home p {
    color: #D6C9E5;
    font-size: 17px;
    line-height: 1.9;
    max-width: 650px;
    margin: 0 auto 35px;
}

.hero-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

#home .hero-buttons a {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 30px;
    text-decoration: none;
    transition: 0.4s ease;
}

#home .hero-buttons a:first-child {
    background-color: #873EE8;
    color: #FFFFFF;
}

#home .hero-buttons a.secondary-btn {
    background-color: transparent;
    color: #BD83FF;
    border: 1px solid #873EE8;
}

#home .hero-buttons a:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 20px rgba(135, 62, 232, 0.4);
}

@media (max-width: 600px) {
    #home {
        padding: 100px 20px;
    }

    #home h2 {
        font-size: 34px;
    }
}
/* PREMIUM HEADER DESIGN */

header {
    background: rgba(28, 16, 48, 0.95);
    padding: 18px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid #59358A;
    backdrop-filter: blur(15px);
}

.logo-icon {
    border-radius: 14px;
    box-shadow: 0 0 20px rgba(135, 62, 232, 0.5);
}

.logo h1 {
    font-size: 27px;
    letter-spacing: 1.5px;
}

nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
}

nav a {
    color: #E6D9F5;
    text-decoration: none;
    margin: 5px 10px;
    font-size: 14px;
    font-weight: 500;
    transition: 0.3s ease;
}

nav a:hover {
    color: #BD83FF;
    transform: translateY(-2px);
}

@media (max-width: 600px) {
    header {
        padding: 15px 5%;
    }

    .logo h1 {
        font-size: 24px;
    }

    nav {
        justify-content: center;
        margin-top: 12px;
    }

    nav a {
        font-size: 13px;
        margin: 6px;
    }
}
/* PREMIUM CONTACT SECTION */

#contact {
    background: linear-gradient(135deg, #160C25, #241637);
    padding: 90px 10%;
}

.contact-label {
    color: #BD83FF;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 4px;
}

#contact h2 {
    color: #FFFFFF;
    font-size: 36px;
    margin: 20px 0;
}

.contact-intro {
    color: #D6C9E5;
    line-height: 1.9;
    max-width: 650px;
}

.contact-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 40px;
}

.contact-card {
    background: #241637;
    border: 1px solid #59358A;
    border-radius: 15px;
    padding: 30px 20px;
    width: 230px;
    transition: 0.4s ease;
}

.contact-card:hover {
    transform: translateY(-8px);
    border-color: #BD83FF;
    box-shadow: 0 8px 20px rgba(135, 62, 232, 0.3);
}

.contact-card h3 {
    color: #C99AFF;
    margin-bottom: 12px;
}

.contact-card p {
    color: #DDDDDD;
    margin-bottom: 20px;
}

.contact-link {
    display: inline-block;
    color: #BD83FF;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
}

.contact-link:hover {
    color: #FFFFFF;
}

.contact-form {
    max-width: 550px;
    margin: 65px auto 0;
    background: #1C1030;
    padding: 35px;
    border: 1px solid #59358A;
    border-radius: 15px;
}

.contact-form h3 {
    color: #BD83FF;
    font-size: 24px;
    margin-bottom: 25px;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 15px;
    margin-bottom: 15px;
    background: #241637;
    color: #FFFFFF;
    border: 1px solid #873EE8;
    border-radius: 8px;
    font-size: 15px;
}

.contact-form button {
    background: #873EE8;
    color: #FFFFFF;
    padding: 13px 28px;
    border: none;
    border-radius: 25px;
    cursor: pointer;
}

.contact-form button:hover {
    background: #BD83FF;
}

@media (max-width: 600px) {
    #contact h2 {
        font-size: 29px;
    }

    .contact-card {
        width: 100%;
    }

    .contact-form {
        padding: 25px 18px;
    }
}
/* PREMIUM FOOTER DESIGN */

footer {
    background: #0A0612;
    padding: 60px 10% 25px;
    border-top: 1px solid #59358A;
}

.footer-content {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 40px;
    padding-bottom: 40px;
}

.footer-brand h2 {
    color: #BD83FF;
    font-size: 28px;
    margin-bottom: 12px;
}

.footer-brand p {
    color: #D6C9E5;
    font-size: 14px;
}

.footer-links h3 {
    color: #C99AFF;
    margin-bottom: 15px;
}

.footer-links a {
    display: block;
    color: #DDDDDD;
    text-decoration: none;
    margin-bottom: 10px;
    font-size: 14px;
    transition: 0.3s;
}

.footer-links a:hover {
    color: #BD83FF;
    padding-left: 5px;
}

.footer-bottom {
    border-top: 1px solid #39234F;
    padding-top: 20px;
    text-align: center;
}

.footer-bottom p {
    color: #A995BD;
    font-size: 13px;
    margin: 8px 0;
}

@media (max-width: 600px) {
    .footer-content {
        flex-direction: column;
        text-align: center;
    }
}